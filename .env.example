# Engineering Validation Platform - example configuration (see docs/APP_SPEC.md §9)
# Copy to .env and adjust. Real .env files are git-ignored.
# All values below are SAFE DUMMIES. Never put real secrets in this file.

# --- All services ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- APIs (results-api: 8001, reporting-api: 8002) ---
PORT=8001

# --- Database (APIs) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evp
# results-api uses evp_writer, reporting-api uses evp_reader
DB_USER=evp_writer
DB_PASSWORD=change-me

# --- results-api + simulator ---
RESULTS_API_KEY=dev-api-key-change-me

# --- Simulator ---
RESULTS_API_URL=http://localhost:8001
SIM_MODE=once
SIM_BATCH_SIZE=10
SIM_INTERVAL_S=60
SIM_FAILURE_RATE=0.08
SIM_DEVICE_COUNT=20
# Optional: set a number to make generated data reproducible
SIM_SEED=

# --- Integration tests only (real PostgreSQL, see docs/APP_SPEC.md §11) ---
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=evp_test
TEST_DB_USER=evp_writer
TEST_DB_PASSWORD=change-me
